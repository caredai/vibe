{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite"],
  "files": {
    "includes": ["**/*", "!.wrangler", "!worker-configuration.d.ts"]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "json": {
    "formatter": {
      "enabled": false
    }
  },
  "html": {
    "formatter": {
      "enabled": false
    }
  },
  "overrides": [
    {
      "includes": ["biome.jsonc"],
      "formatter": {
        "enabled": true
      },
      "linter": {
        "enabled": true
      },
      "assist": {
        "enabled": true
      }
    },
    {
      "includes": ["*.jsonc"],
      "json": {
        "parser": {
          "allowComments": true,
          "allowTrailingCommas": true
        }
      }
    }
  ]
}
